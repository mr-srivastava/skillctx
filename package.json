{
	"name": "skillctx",
	"version": "0.0.1",
	"private": true,
	"description": "Local skill compiler for coding agents. Phase 0: read-only skill inventory.",
	"license": "UNLICENSED",
	"bin": {
		"skillctx": "src/cli/index.ts"
	},
	"type": "module",
	"scripts": {
		"dev": "bun run src/cli/index.ts",
		"test": "bun test",
		"lint": "oxlint --type-aware && oxfmt --check",
		"format": "oxfmt",
		"lint:fix": "oxlint --type-aware --fix && oxfmt",
		"typecheck": "tsc --noEmit",
		"build": "bun run scripts/build.ts && bun run scripts/sign.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"diff": "^9.0.0",
		"hast-util-to-jsx-runtime": "^2.3.6",
		"lucide-react": "^1.50.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/hast": "^3.0.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"bun-plugin-tailwind": "^0.1.2",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.1"
}
