{
	"name": "skillctx",
	"version": "0.0.1",
	"description": "Local skill compiler for coding agents. Phase 0: read-only skill inventory.",
	"type": "module",
	"private": true,
	"bin": {
		"skillctx": "src/cli/index.ts"
	},
	"scripts": {
		"dev": "bun run src/cli/index.ts",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"build": "bun build src/cli/index.ts --compile --outfile dist/skillctx && bun run scripts/sign.ts"
	},
	"license": "UNLICENSED",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"diff": "^9.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}
